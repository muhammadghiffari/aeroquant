# Alpaca paper credentials
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_TRADE=true
ALPACA_EXPECTED_ACCOUNT_ID=
AUTONOMOUS_TRADING_ENABLED=false

# Remote LLM provider
LLM_PROVIDER=featherless
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=zai-org/GLM-5.3-Flash
FEATHERLESS_LIGHT_MODEL=zai-org/GLM-5.2
FEATHERLESS_HEAVY_MODEL=zai-org/GLM-5.3-Flash
LLM_MAX_TOKENS=4096

# Telegram alerts (create the bot/chat first; keep values local)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scalp universe (tech + BTC-sensitive names)
SCALP_WATCHLIST_SYMBOLS=NVDA,AMD,MSTR,COIN,TSLA,AAPL,MSFT

# Local embeddings are intentionally disabled for laptop/VPS portability.
EMBED_PROVIDER=disabled
EMBED_MODEL=

# Optional BTC context overrides
BTC_SYMBOL=BTC/USD
BTC_CONTEXT_LOOKBACK_MIN=360
BTC_CONTEXT_MAX_AGE_SECONDS=300
